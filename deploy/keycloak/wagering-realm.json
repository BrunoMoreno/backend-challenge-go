{
  "realm": "wagering",
  "displayName": "Wagering",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "wagering:provider",
        "description": "Provedor de jogos: envia operações e consulta as próprias transações."
      },
      {
        "name": "wagering:internal",
        "description": "Serviço interno: consulta qualquer transação."
      },
      {
        "name": "wallet:internal",
        "description": "Serviço interno: gerencia carteiras, ledger e reconciliação."
      }
    ]
  },
  "groups": [],
  "clients": [
    {
      "clientId": "wager-api",
      "name": "Wagering API (resource server)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "wager-api-secret",
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "defaultClientScopes": ["web-origins", "acr", "roles", "profile", "email"],
      "optionalClientScopes": ["address", "phone", "offline_access"]
    },
    {
      "clientId": "provider-a",
      "name": "Provedor A (teste)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "provider-a-secret",
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "consentRequired": false,
      "defaultClientScopes": ["web-origins", "acr", "roles", "profile", "email"],
      "optionalClientScopes": ["address", "phone", "offline_access"],
      "protocolMappers": [
        {
          "name": "audience wager-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "wager-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "provider_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "provider_id",
            "claim.value": "provider-a",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "provider-b",
      "name": "Provedor B (teste)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "provider-b-secret",
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "consentRequired": false,
      "defaultClientScopes": ["web-origins", "acr", "roles", "profile", "email"],
      "optionalClientScopes": ["address", "phone", "offline_access"],
      "protocolMappers": [
        {
          "name": "audience wager-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "wager-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "provider_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "provider_id",
            "claim.value": "provider-b",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "wagering-internal",
      "name": "Serviço interno (teste)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "wagering-internal-secret",
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "consentRequired": false,
      "defaultClientScopes": ["web-origins", "acr", "roles", "profile", "email"],
      "optionalClientScopes": ["address", "phone", "offline_access"],
      "protocolMappers": [
        {
          "name": "audience wager-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "wager-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "scopeMappings": [],
  "users": [
    {
      "username": "service-account-provider-a",
      "enabled": true,
      "serviceAccountClientId": "provider-a",
      "realmRoles": ["wagering:provider"],
      "clientRoles": {}
    },
    {
      "username": "service-account-provider-b",
      "enabled": true,
      "serviceAccountClientId": "provider-b",
      "realmRoles": ["wagering:provider"],
      "clientRoles": {}
    },
    {
      "username": "service-account-wagering-internal",
      "enabled": true,
      "serviceAccountClientId": "wagering-internal",
      "realmRoles": ["wagering:internal", "wallet:internal"],
      "clientRoles": {}
    }
  ],
  "defaultDefaultClientScopes": ["web-origins", "acr", "roles", "profile", "email"],
  "defaultOptionalClientScopes": ["address", "phone", "offline_access", "microprofile-jwt"]
}