# Papéis da instância: http,sqs-consumer,outbox-publisher,reference-worker
# (obrigatório; cada papel exige as variáveis do seu bloco)
APP_ROLES=http

# Endereço HTTP do serviço
APP_HTTP_ADDR=:8080

# DSN PostgreSQL (role da aplicação)
# Role da aplicação: wager_app (sem escrita no ledger). Migrations: use
# DATABASE_URL abaixo (role app, dona do schema). Obrigatória.
APP_DATABASE_URL=postgres://wager_app:wager_app@localhost:5432/wagering?sslmode=disable

# Keycloak (realm importado em deploy/keycloak; identidades de teste em
# deploy/keycloak/README.md). Obtenha tokens com `make kc-token CLIENT=provider-a`.
APP_KEYCLOAK_ISSUER=http://localhost:8081/realms/wagering
APP_KEYCLOAK_JWKS_URL=http://localhost:8081/realms/wagering/protocol/openid-connect/certs
APP_KEYCLOAK_CLIENT_ID=wager-api

# LocalStack (SQS)
APP_SQS_ENDPOINT=http://localhost:4566
APP_SQS_REGION=us-east-1

# Consumidor da fila de operações (papel sqs-consumer; filas obrigatórias)
APP_SQS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
APP_SQS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
APP_SQS_MAX_RECEIVE_COUNT=5
APP_SQS_VISIBILITY_TIMEOUT=30s
APP_SQS_CONSUMER_CONCURRENCY=4
APP_SQS_CONSUMER_BACKOFF_BASE=1s
APP_SQS_CONSUMER_BACKOFF_MAX=15m

# Outbox publisher (papel outbox-publisher; fila de eventos obrigatória).
# Lease >= BatchSize×SendTimeout para o lote nunca estourar a posse no envio.
APP_SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo
APP_OUTBOX_BATCH_SIZE=10
APP_OUTBOX_POLL_INTERVAL=1s
APP_OUTBOX_LEASE=100s
APP_OUTBOX_SEND_TIMEOUT=10s
APP_OUTBOX_BACKOFF_BASE=1s
APP_OUTBOX_BACKOFF_MAX=15m

# Worker de referências (papel reference-worker): resolução tardia de
# PENDING_REFERENCE com backoff durável; rejeição final REFERENCE_NOT_FOUND
# após TTL ou limite de tentativas.
APP_REFERENCE_WORKER_BATCH_SIZE=10
APP_REFERENCE_WORKER_POLL_INTERVAL=1s
APP_REFERENCE_WORKER_MAX_ATTEMPTS=30
APP_REFERENCE_WORKER_TTL=24h
APP_REFERENCE_WORKER_BACKOFF_BASE=1s
APP_REFERENCE_WORKER_BACKOFF_MAX=15m

# Observabilidade
APP_LOG_LEVEL=info
APP_METRICS_ADDR=:9090

# Desligamento ordenado (prazo total dos hooks OnStop)
APP_SHUTDOWN_TIMEOUT=30s

# Usado pelo Makefile e golang-migrate (migrations via host, role de migração)
DATABASE_URL=postgres://app:app@localhost:5432/wagering?sslmode=disable